# SoilMate Environment Configuration

# Required: Google Gemini API Keys for Agentic Reasoning
# Support multiple keys separated by comma for automatic failover on 429/quota errors
# Example: GEMINI_API_KEYS=key1,key2,key3
# Or a single key: GEMINI_API_KEYS=your_gemini_api_key_here
GEMINI_API_KEYS=your_primary_gemini_api_key_here,your_backup_gemini_api_key_here

# Backward-compatibility alias for single key
GEMINI_API_KEY=your_primary_gemini_api_key_here

# Optional: Sarvam AI API Key for Indian Language Voice (Saaras STT & Bulbul TTS) & Translation (Mayura)
# Free credits from https://www.sarvam.ai/
# If omitted, deep-translator and browser Web Speech API are used as fallback
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: data.gov.in API Key for Live Mandi Commodity Prices (Agmarknet)
# Free registration at https://data.gov.in/user/register
DATA_GOV_API_KEY=your_data_gov_api_key_here

# Database path (default: SQLite in data directory)
DATABASE_URL=sqlite+aiosqlite:///app/data/soilmate.db

# Server Configuration
PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

